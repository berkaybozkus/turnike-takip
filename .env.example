# Copy to .env to override the defaults. All values are optional.

# SQLite file locations
# TAKIP_DB=data/turnike.db
# KAYNAK_DB=data/kaynak_demo.db

# Read scans from a SQL Server instead of the demo file (requires: pip install pyodbc)
# KAYNAK_ODBC=Driver={ODBC Driver 18 for SQL Server};Server=.;Database=TurnikeDemoKaynak;Trusted_Connection=yes;TrustServerCertificate=yes;

# Sync interval in seconds
# SENKRON_ARALIGI=30

# Public demo mode: resets data periodically, disables password change, HTTPS-only cookies
# CANLI_DEMO=1
# DEMO_SIFIRLAMA_DAKIKA=60

# Signs the session cookie. If unset, a new key is generated on every start.
# OTURUM_ANAHTARI=change-me
